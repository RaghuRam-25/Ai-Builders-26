# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ─── MongoDB Atlas ────────────────────────────────────────────────────────────
# Server-only. Never expose this to the frontend.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/janasheba?retryWrites=true&w=majority
MONGODB_DB_NAME=janasheba

# ─── Authentication ───────────────────────────────────────────────────────────
# Server-only. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
BCRYPT_ROUNDS=10

# Mobile number that is promoted to role=admin on registration.
OWNER_MOBILE=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allow-list. Include your web origin and the Capacitor scheme.
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,http://localhost

# ─── AI assistant (optional) ──────────────────────────────────────────────────
# When unset the assistant uses the deterministic context-aware engine.
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=20000

# ─── File uploads (document scan) ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── One-off MySQL → MongoDB migration (optional) ─────────────────────────────
# Leave empty to skip. Used only by `pnpm db:migrate-mysql`.
DATABASE_URL_LEGACY=
