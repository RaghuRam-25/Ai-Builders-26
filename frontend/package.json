{
  "name": "janasheba-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:all": "concurrently -n backend,frontend -c cyan,green \"pnpm --dir ../backend dev\" \"next dev --port 3000\"",
    "build": "next build",
    "build:static": "next build",
    "start": "npx serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "cap:sync": "cap sync android",
    "cap:open:android": "cap open android",
    "android:apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/preferences": "^7.0.2",
    "@tanstack/react-query": "^5.90.12",
    "clsx": "^2.1.1",
    "next": "^15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.19.3",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.7",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3"
  }
}
